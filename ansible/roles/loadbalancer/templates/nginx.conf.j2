user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    log_format upstream_log '$remote_addr "$request" $status upstream=$upstream_addr '
                            'upstream_status=$upstream_status time=$request_time';
    access_log /var/log/nginx/access.log upstream_log;
    upstream web_pool {
        zone web_pool 64k;
{% if nginx_lb_method == 'hash' %}
        hash $uri consistent;
{% endif %}
{% for node in groups['web'] %}
        server {{ hostvars[node].private_ip }}:80 max_fails=1 fail_timeout=10s;
{% endfor %}
        keepalive 16;
    }
    server {
        listen 80 default_server;
        server_name _;
        client_max_body_size 20m;
        add_header X-LB-Method {{ nginx_lb_method }} always;
        location / {
            proxy_pass http://web_pool;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 2s;
            proxy_read_timeout 15s;
            proxy_send_timeout 15s;
            proxy_next_upstream error timeout http_502 http_503 http_504;
            proxy_next_upstream_tries 2;
            proxy_next_upstream_timeout 20s;
        }
    }
}
